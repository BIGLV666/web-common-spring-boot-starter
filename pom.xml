<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>io.github.biglv666</groupId>
    <artifactId>web-common-spring-boot-starter</artifactId>
    <version>0.5.0</version>
    <packaging>jar</packaging>

    <name>web-common-spring-boot-starter</name>
    <description>轻量级 Web 层通用封装 Spring Boot Starter，提供统一 Result 返回体、分段错误码枚举与全局异常处理。</description>
    <url>https://github.com/BIGLV666/web-common-spring-boot-starter</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>biglv666</id>
            <name>LV</name>
            <url>https://github.com/BIGLV666</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/BIGLV666/web-common-spring-boot-starter.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/BIGLV666/web-common-spring-boot-starter.git</developerConnection>
        <url>https://github.com/BIGLV666/web-common-spring-boot-starter/tree/main</url>
    </scm>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- springdoc 版本：Boot 3.x 线用 2.8.x；boot4 profile 切 3.x（Boot 4 线） -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- swagger 注解版本须与 springdoc 携带的 swagger-core 对齐，否则 NoSuchMethodError -->
        <swagger.version>2.2.47</swagger.version>
        <!-- MyBatis-Plus 适配基准版本：IPage / Page 接口自 3.x 起保持稳定 -->
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
    </properties>

    <dependencies>
        <!--
            Web 能力（RestControllerAdvice 等）使用方一般自带，这里声明为 provided：
            编译期可见、不向使用方传递，避免污染使用方的 Spring Boot 版本。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 参数校验能力（@Valid / @NotBlank 等），同样由使用方自带 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            Spring Data 通用接口：仅供 PageResult.from(Page) 编译期可见，
            使用方用 Spring Data 分页时其依赖树自带；不用 Spring Data 时
            走 PageResult.of，本依赖不传递、零影响。
        -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            MyBatis-Plus 分页接口：仅供 MybatisPlusPageResultNormalizer 编译期可见，
            provided + optional。使用方引入 MP 时其依赖树自带；未使用时装配按类名
            条件跳过，本依赖不传递、零影响。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            Micrometer：仅供 MicrometerExceptionMetrics 编译期可见，provided + optional；
            使用方类路径有 micrometer（通常经 actuator）才生效，否则装配条件跳过。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            以下三项（spring-test / json-path / hamcrest）仅供 ResultMatchers
            测试工具类编译期可见，面向使用方的测试代码，不参与运行期；
            全部 provided + optional，不向使用方传递。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            Swagger 注解（CLASS 保留级别，运行期零依赖）：
            使用方工程里有 springdoc/knife4j 时，自动为 Result 字段生成文档描述与示例值。
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            springdoc customizer 接口：仅供 ErrorCodeOpenApiCustomizer 编译期可见，
            provided + optional；OpenAPI 模型（swagger-models）随本依赖传递解析，
            版本与 springdoc 自身匹配，勿单独声明以免版本错配。
            使用方工程无 springdoc 时装配按类名条件跳过，零影响。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <version>${springdoc.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            Jackson 3（tools.jackson，Spring Boot 4 起为默认 JSON 库）：provided + optional，
            仅供 Jackson3ResultJsonWriter 编译期可见。Boot 3.x 运行时走 Jackson 2 路径，
            本依赖不向使用方传递；Boot 4 默认依赖树下则由使用方自带。
            父 POM 是 Boot 3.5，不管理 tools.jackson 版本，故此处显式指定。
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.2</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            Jackson 2 databind（Boot 3.x 默认 JSON 库）：provided + optional，
            仅供 Jackson2ResultJsonWriter / ResultJsonWriterFactory 编译期可见。
            Boot 4 起 starter-web 默认只带 Jackson 3，Jackson 2 类型需显式声明；
            显式版本与 Boot 3.5 BOM 管理值一致（2.21.2），Boot 4 BOM 的
            jackson-2-bom（2.21.5）为同线补丁版本，API 兼容，两代依赖树均可
            解析。运行期由使用方自带。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.21.2</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!--
            Jackson 3.2 要求 jackson-annotations 2.22+（JsonApplyView 为 2.22 新增），
            显式提升覆盖父 POM 管理的 2.21，供 tools.jackson 编译与测试使用；
            注解 API 向后兼容，@JsonInclude 等主代码用法不受影响。provided 不向使用方传递，
            Boot 4 运行时的注解版本由其自身 BOM 管理。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.22</version>
            <scope>provided</scope>
        </dependency>
        <!-- 自动装配开关属性的 IDE 提示元数据 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：测试应用 + MockMvc 集成测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            springdoc UI（含 starter-common 与自动配置）：仅测试期使用，
            验证错误码字典 OpenAPI 扩展（x-error-codes）；版本随 profile
            切换（默认 2.8.x 对 Boot 3.x，boot4 profile 为 3.x 对 Boot 4）。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            MyBatis-Plus 扩展：仅测试期使用，提供真实的 Page 实现来覆盖
            MybatisPlusPageResultNormalizer；生产代码只依赖 core 的 IPage 接口。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- jar manifest 携带 Implementation-Version，便于运行期识别版本 -->
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!--
                Central 要求附 sources jar。锁定 3.2.1：3.3.0 起新增的重复附加检查
                与 central-publishing-maven-plugin 的 staging 重跑互斥，会导致部署失败。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Maven Central 要求附 javadoc jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <docencoding>UTF-8</docencoding>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Maven Central 要求 GPG 签名 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            测试代码的 @AutoConfigureMockMvc import 统一取 Boot 4 包名
            （boot.webmvc.test.autoconfigure，3.5 无此包，Boot 4 已删除 3.5 旧包），
            两端各需一块补丁，二选一随父 POM 版本切换：
            - 默认（Boot 3.5）：挂载 src/test-compat35 兼容桥（同名注解壳指向 3.5 真实注解）；
            - boot4（CI Boot 4 job，父 POM 已被改写为 4.x）：引入 spring-boot-starter-webmvc-test
              提供真正的同名注解。
        -->
        <profile>
            <id>compat35</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-boot35-compat-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/test-compat35</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>boot4</id>
            <properties>
                <!-- Boot 4 线使用 springdoc 3.x（接口 FQCN 与 2.x 一致则装配与测试同样生效） -->
                <springdoc.version>3.1.1</springdoc.version>
                <swagger.version>2.2.55</swagger.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-webmvc-test</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
